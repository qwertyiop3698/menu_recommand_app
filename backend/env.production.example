# Optional TiDB Cloud MySQL settings.
# If these are omitted locally, backend/app/database_mysql.py uses SQLite.
TIDB_HOST=gateway01.ap-northeast-1.prod.aws.tidbcloud.com
TIDB_PORT=4000
TIDB_USER=your_tidb_user
TIDB_PASSWORD=your_tidb_password
TIDB_DATABASE=test

# JWT settings
SECRET_KEY=change_this_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Weather API settings
KMA_API_KEY=your_kma_api_key
KMA_WEATHER_URL=https://apihub.kma.go.kr/api/typ02/openApi/VilageFcstInfoService_2.0/getUltraSrtFcst

# Seoul grid coordinates
SEOUL_NX=55
SEOUL_NY=127

ENVIRONMENT=production
